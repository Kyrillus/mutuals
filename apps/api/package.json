{
  "name": "@mutuals/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The public API. Every client -- the web app, a CLI, an MCP server -- speaks only this.",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/main.js"
  },
  "dependencies": {
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@mutuals/core": "workspace:*",
    "@mutuals/db": "workspace:*",
    "fastify": "5.12.1",
    "fastify-type-provider-zod": "7.0.0",
    "pino": "10.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "pino-pretty": "13.1.3"
  }
}
