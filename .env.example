# Copy to .env and adjust. Never commit .env.
#
# One .env at the repo root serves every package (ADR-010). Node reads it natively
# via --env-file-if-exists; Vite reads it via envDir. There is no dotenv dependency.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# If your password contains @ : / or #, percent-encode it, or the URL will not
# parse. Example: a password of "p/w@rd" becomes "p%2Fw%40rd".
#
# DB_PORT and the port inside DATABASE_URL must be changed together.
DB_PORT=5432
DATABASE_URL=postgres://mutuals:mutuals@localhost:5432/mutuals_dev
TEST_DATABASE_URL=postgres://mutuals:mutuals@localhost:5432/mutuals_test
# The Playwright suite truncates this one between tests, so it is a third database rather than a
# clone of either above, and its own guard refuses anything not ending in _e2e. `pnpm db:up`
# creates all three.
E2E_DATABASE_URL=postgres://mutuals:mutuals@localhost:5432/mutuals_e2e

# A managed Postgres reached through a transaction pooler, for the pg-boss lifecycle
# test (ADR-095). Deliberately unset: ADR-058 claims pg-boss is safe through Supabase's
# pooler by reasoning rather than by measurement, and §13's R7 stays open until this is
# filled in. The test skips while it is empty. Do NOT point it at local Postgres -- it would
# then pass while measuring nothing, which is worse than skipping.
# Example: postgres://postgres.<ref>:<pw>@<host>.pooler.supabase.com:6543/postgres
POOLER_DATABASE_URL=

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Whether this process also runs the background worker (ADR-062). `on` is the default
# because `pnpm dev` is meant to be one command; `off` is the whole scale-out path --
# the API stops working jobs and `apps/worker` runs them in its own process.
MUTUALS_WORKER=on

# Profile defaults used when the workspace is first created. Both are
# load-bearing: a phone number cannot be normalised to E.164 without a region,
# and warmth cannot decay on whole civil days without a timezone.
DEFAULT_PHONE_REGION=DE
DEFAULT_TIME_ZONE=Europe/Berlin

# ---------------------------------------------------------------------------
# LLM (Stage 6). The app runs with all of this unset: the three agent routes
# then answer 503 and say the feature needs a key. Nothing else changes.
# ---------------------------------------------------------------------------
# `live` calls the provider, `replay` reads fixtures/llm and never opens a
# socket (this is what the e2e suite uses), `off` switches the feature off.
LLM_MODE=live
# One key, any model: https://openrouter.ai/keys
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Model per task, so cheap and strong models can be mixed. These are only the
# fallbacks: `llm_setting` overrides them per task without a deploy (ADR-064).
# Browse: https://openrouter.ai/models?supported_parameters=structured_outputs
LLM_MODEL_EXTRACTION=openai/gpt-4.1-mini
LLM_MODEL_ANSWER=openai/gpt-4.1-mini
LLM_MODEL_SUMMARY=openai/gpt-4.1-mini
# Embeddings are Stage 8 (ADR-069). `embed()` exists and is typed; nothing in
# Phase 1 calls it. OpenRouter's model catalogue lists no embedding models at
# all today, so the default base URL is OpenAI direct -- same wire format.
LLM_MODEL_EMBEDDING=openai/text-embedding-3-small
LLM_EMBEDDING_BASE_URL=https://api.openai.com/v1
# Falls back to OPENROUTER_API_KEY when the base URL is still OpenRouter's.
LLM_EMBEDDING_API_KEY=
# One deadline for the whole request, one for a single attempt (ADR-065). The
# total is created before the retry loop, so a hung provider cannot be retried
# into a three-minute request.
LLM_TOTAL_TIMEOUT_MS=45000
LLM_ATTEMPT_TIMEOUT_MS=20000
# Whether the request and response bodies are stored in `llm_call`. A privacy
# switch: those bodies hold your notes and your contacts' details. The trace
# still records cost, tokens, model and latency with this off.
LLM_TRACE_BODIES=on
# A circuit breaker, not a budget: checked immediately before every billable
# request to the model provider, so a loop cannot bill six generations per user
# action through retries (ADR-070). Q7, answered 2026-09-05. 0 disables it --
# not recommended for a key sitting in a file on a laptop.
LLM_DAILY_COST_LIMIT_USD=5.00
